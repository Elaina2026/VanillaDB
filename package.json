{
  "name": "vanilladatabase",
  "version": "1.3.2",
  "private": true,
  "type": "module",
  "imports": {
    "#shared/*": "./shared/*"
  },
  "scripts": {
    "dev:server": "tsx watch src/server/index.ts",
    "dev:web": "vite",
    "dev": "concurrently \"tsx watch src/server/index.ts\" \"vite\"",
    "build:web": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "node dist/src/server/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "admin:reset": "node dist/src/server/cli.js",
    "benchmark": "tsx src/server/benchmark.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.1.0",
    "@fastify/helmet": "^13.0.1",
    "@fastify/multipart": "^9.0.3",
    "@fastify/static": "^8.1.1",
    "@monaco-editor/react": "^4.7.0",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.0",
    "@tanstack/react-query": "^5.67.1",
    "@tanstack/react-table": "^8.21.2",
    "argon2": "^0.41.1",
    "clsx": "^2.1.1",
    "csv-parse": "^5.6.0",
    "csv-stringify": "^6.5.2",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "lucide-react": "^1.16.0",
    "nanoid": "^5.1.3",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.54.2",
    "tailwind-merge": "^3.0.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vite": "^6.2.0",
    "vitest": "^3.0.8"
  }
}
