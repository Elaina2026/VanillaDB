# ==============================================================================
# VanillaDatabase Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BẮT BUỘC / QUAN TRỌNG (ESSENTIAL)
# ------------------------------------------------------------------------------
# Môi trường chạy ứng dụng: "production" hoặc "development"
NODE_ENV=production

# IP Host và Cổng lắng nghe
VDB_HOST=0.0.0.0
VDB_PORT=3000

# Thư mục lưu trữ toàn bộ dữ liệu SQLite, backup, metadata
# Mặc định tạo thư mục ./data ngay tại thư mục chạy
VDB_DATA_DIR=./data

# Khóa bí mật mã hóa Session Cookie cho tài khoản Admin
# NẾU ĐỂ TRỐNG: Hệ thống sẽ tự tạo khóa ngẫu nhiên 64-char lưu vào ./data/system/.session_secret
# KHUYẾN NGHỊ TRÊN PRODUCTION: Đặt một chuỗi ngẫu nhiên dài ít nhất 32 ký tự
VDB_SESSION_SECRET=

# ------------------------------------------------------------------------------
# 2. TẠO TÀI KHOẢN ADMIN TỰ ĐỘNG (OPTIONAL BOOTSTRAP)
# ------------------------------------------------------------------------------
# Nếu đặt thông tin dưới đây, hệ thống sẽ tự tạo Admin khi khởi động lần đầu (nếu chưa có admin nào)
# Nếu không đặt, bạn có thể tạo qua giao diện web lần đầu hoặc dùng lệnh: npm run admin:reset <username> <password>
VDB_ADMIN_USERNAME=
VDB_ADMIN_PASSWORD=

# ------------------------------------------------------------------------------
# 3. MẠNG VÀ BẢO MẬT (NETWORK & SECURITY - OPTIONAL)
# ------------------------------------------------------------------------------
# Bật "true" nếu chạy sau Reverse Proxy (Nginx, Cloudflare, Caddy, Traefik) để nhận diện đúng IP client qua header X-Forwarded-For
VDB_TRUST_PROXY=false

# Danh sách domain cho phép gọi CORS (ngăn cách bởi dấu phẩy). Để trống = cho phép tất cả (*)
# Ví dụ: VDB_CORS_ORIGINS=http://localhost:5173,https://my-app.com
VDB_CORS_ORIGINS=

# ------------------------------------------------------------------------------
# 4. HIỆU NĂNG VÀ GIỚI HẠN (PERFORMANCE & LIMITS - OPTIONAL)
# ------------------------------------------------------------------------------
# Thời gian chờ SQLite lock retry trước khi báo lỗi SQLITE_BUSY (milliseconds)
VDB_SQL_BUSY_TIMEOUT_MS=5000

# Dung lượng tối đa của một Request Body (Megabytes)
VDB_MAX_REQUEST_BODY_MB=10

# Dung lượng tối đa của file SQLite import (Megabytes)
VDB_MAX_IMPORT_MB=1024

# Số dòng tối đa trả về trong một câu query SELECT (tránh tràn RAM)
VDB_MAX_QUERY_ROWS=100000

# Timeout cho câu query (0 = không giới hạn timeout)
VDB_QUERY_TIMEOUT_MS=0

# ------------------------------------------------------------------------------
# 5. NHẬT KÝ VÀ DEBUG (LOGGING - OPTIONAL)
# ------------------------------------------------------------------------------
# Mức log: "debug" | "info" | "warn" | "error" | "fatal"
VDB_LOG_LEVEL=info

# In toàn bộ câu lệnh SQL ra terminal console (chỉ nên bật khi debug)
VDB_LOG_SQL=false
