# ==============================================================================
# VanillaDatabase Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE & RUNTIME SETTINGS (REQUIRED / ESSENTIAL)
# ------------------------------------------------------------------------------
# Application environment: "production" or "development"
NODE_ENV=production
# Optional override for environment (takes precedence over NODE_ENV if set)
# VDB_ENV=production

# Server Host IP & Port
VDB_HOST=0.0.0.0
VDB_PORT=3000

# Base directory for all database files, backups, system metadata, and storage
# Default: ./data relative to working directory
VDB_DATA_DIR=./data

# Session Cookie Secret Key for Admin & User Dashboard authentication
# IF EMPTY: Auto-generates a 64-char secure random hex and persists to ./data/system/.session_secret
# PRODUCTION RECOMMENDATION: Set a random string of at least 32 characters
VDB_SESSION_SECRET=

# Master Encryption Key for Data-At-Rest Encryption (AES-256-GCM)
# Used for encrypting backup snapshots, media files, and SQL crypto helper functions
# IF EMPTY: Auto-generates a secure key and persists to ./data/system/.master_key
# VDB_MASTER_KEY=
# VDB_ENCRYPTION_KEY=

# ------------------------------------------------------------------------------
# 2. OPTIONAL BOOTSTRAP ADMINISTRATOR
# ------------------------------------------------------------------------------
# Auto-creates initial Super Admin on startup if no admin user exists in metadata DB
# If left empty, set up via the Web UI on first load or via CLI: npm run admin:reset <username> <password>
VDB_ADMIN_USERNAME=
VDB_ADMIN_PASSWORD=

# ------------------------------------------------------------------------------
# 3. NETWORK & SECURITY
# ------------------------------------------------------------------------------
# Set to "true" when behind Reverse Proxies (Nginx, Caddy, Cloudflare, Traefik)
# Allows proper client IP resolution from X-Forwarded-For headers
VDB_TRUST_PROXY=false

# Allowed CORS Origins (comma-separated). Leave empty to allow all origins (*)
# Example: VDB_CORS_ORIGINS=http://localhost:5173,https://app.example.com
VDB_CORS_ORIGINS=

# ------------------------------------------------------------------------------
# 4. PERFORMANCE, ENGINE & RESOURCE LIMITS
# ------------------------------------------------------------------------------
# SQLite busy timeout before raising SQLITE_BUSY error (in milliseconds)
VDB_SQL_BUSY_TIMEOUT_MS=5000

# Maximum request body size for JSON payloads (Megabytes)
VDB_MAX_REQUEST_BODY_MB=10

# Maximum file upload size for database imports & media uploads (Megabytes)
VDB_MAX_IMPORT_MB=1024

# Maximum rows returned in a single SQL query execution
VDB_MAX_QUERY_ROWS=100000

# Query execution timeout in milliseconds (0 = unlimited)
VDB_QUERY_TIMEOUT_MS=0

# ------------------------------------------------------------------------------
# 5. LOGGING & DEBUGGING
# ------------------------------------------------------------------------------
# Log level: "trace" | "debug" | "info" | "warn" | "error" | "fatal"
VDB_LOG_LEVEL=info

# Print raw SQL queries to console logs (use only for debugging)
VDB_LOG_SQL=false
